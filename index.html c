<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Black Background</title>
    <!-- Loading Tailwind CSS for easy styling -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-gray-200 min-h-screen p-6 md:p-12 font-sans">
    
    <div class="max-w-7xl mx-auto">
        <!-- Header Section -->
        <header class="text-center mb-12 mt-8">
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Dark Theme Gallery</h1>
            <p class="text-gray-400 text-lg">A responsive layout for three images.</p>
        </header>

        <main class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <!-- Image Card 1 -->
            <div class="bg-gray-900 rounded-2xl overflow-hidden shadow-2xl border border-gray-800 transition-transform hover:-translate-y-1 duration-300">
                <img src="https://placehold.co/600x400/1a1a1a/ffffff?text=Image+1" alt="Placeholder 1" class="w-full h-auto aspect-video object-cover">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-white mb-2">First Image</h2>
                    <p class="text-sm text-gray-400 leading-relaxed">This is a placeholder for your first image. The layout stacks in a single column on mobile and expands to three columns on larger screens.</p>
                </div>
            </div>

            <!-- Image Card 2 -->
            <div class="bg-gray-900 rounded-2xl overflow-hidden shadow-2xl border border-gray-800 transition-transform hover:-translate-y-1 duration-300">
                <img src="https://placehold.co/600x400/1a1a1a/ffffff?text=Image+2" alt="Placeholder 2" class="w-full h-auto aspect-video object-cover">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-white mb-2">Second Image</h2>
                    <p class="text-sm text-gray-400 leading-relaxed">This is a placeholder for your second image. The cards have a subtle hover effect to make them feel interactive.</p>
                </div>
            </div>

            <!-- Image Card 3 -->
            <div class="bg-gray-900 rounded-2xl overflow-hidden shadow-2xl border border-gray-800 transition-transform hover:-translate-y-1 duration-300">
                <img src="https://placehold.co/600x400/1a1a1a/ffffff?text=Image+3" alt="Placeholder 3" class="w-full h-auto aspect-video object-cover">
                <div class="p-6">
                    <h2 class="text-xl font-semibold text-white mb-2">Third Image</h2>
                    <p class="text-sm text-gray-400 leading-relaxed">This is a placeholder for your third image. The dark gray backgrounds help separate the cards from the pure black page background.</p>
                </div>
            </div>

        </main>
    </div>

</body>
</html>
